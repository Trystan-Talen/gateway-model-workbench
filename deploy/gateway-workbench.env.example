# 复制为 /etc/gateway-workbench.env，按实际情况修改。说明见 docs/deployment.md。

# 监听地址：直接用 IP:端口访问时填 0.0.0.0；前面有 Caddy/Nginx 时保持 127.0.0.1。
ROUTE_TEST_HOST=0.0.0.0
ROUTE_TEST_PORT=3003

# 运行数据目录（绝对路径），与代码目录分开，重新部署代码不影响数据。
ROUTE_TEST_DATA_DIR=/srv/gateway-workbench-data

# 前面有反向代理时填代理地址（同机代理填 127.0.0.1），用于识别真实访问者 IP。
# 直接对外监听时必须留空，否则访问者可以伪造来源地址。
ROUTE_TEST_TRUSTED_PROXIES=

# 通过 HTTPS 访问时改为 1；用 http:// 访问时必须保持 0，否则无法登录。
ROUTE_TEST_SECURE_COOKIE=0

# 服务器没有系统安全存储，密钥只在本次运行内存中有效。
ROUTE_TEST_DISABLE_CREDENTIAL_STORE=1

PYTHONUNBUFFERED=1
